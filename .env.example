# Copia este archivo a .env.local y coloca tus valores reales.

# Development key de Riot: caduca cada 24h. Production key: requiere aprobación de Riot.
RIOT_API_KEY=

# Cadena de conexión a Postgres (Neon / Supabase / Vercel Postgres).
# Ej.: postgresql://usuario:password@host:5432/basededatos?sslmode=require
DATABASE_URL=

# Secreto para firmar las sesiones (HMAC). Genera uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
AUTH_SECRET=
